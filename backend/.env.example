# ─── Workbench runtime ────────────────────────────────────────────────
WM_ENV=development
WM_HOST=127.0.0.1
WM_PORT=8000
WM_LOG_LEVEL=info

# ─── Workbench authentication ─────────────────────────────────────────
# CHANGE THIS before running anywhere other than your own laptop.
WM_JWT_SECRET=dev-only-workbench-secret-change-me-please-32b
WM_JWT_ALGORITHM=HS256
WM_TOKEN_TTL_SECONDS=3600

# ─── Lab gate ─────────────────────────────────────────────────────────
# When 0, every /api/vuln/* route returns 404. Never set to 1 on a host
# that is reachable from an untrusted network.
WM_LAB_MODE=1

# ─── CORS ─────────────────────────────────────────────────────────────
WM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173